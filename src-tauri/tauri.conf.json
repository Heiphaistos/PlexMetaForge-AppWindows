{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PlexMetaForge",
  "version": "1.5.0",
  "identifier": "com.heiphaistos.plexmetaforge",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PlexMetaForge",
        "width": 1280,
        "height": 820,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; connect-src 'self' https://api.github.com https://raw.githubusercontent.com https://codeload.github.com"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI2ODRFNUU4MTZEMDZFNjQKUldSa2J0QVc2T1dFSm9meC9hR0t1VDU4a1QyOS9iblU1alBOZ1R4eUhKekNvTGxtVGpjbjVEUXEK",
      "endpoints": [
        "https://github.com/heiphaistos44-crypto/PlexMetaForge/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  }
}
